# Groq free tier: https://console.groq.com/keys
GROQ_API_KEY=

# Intent engine (server-side only — never expose these to the browser)
INTENT_LLM_API_KEY=
INTENT_LLM_BASE_URL=https://api.groq.com/openai/v1
INTENT_LLM_MODEL=openai/gpt-oss-20b
# Groq strict JSON schema is supported by gpt-oss-20b/120b. Set false for best-effort models.
INTENT_LLM_STRICT_JSON_SCHEMA=true
# With no key, the intent route automatically uses the local mock classifier.
INTENT_LLM_MOCK=false

# Email sending
# mock = in-memory only; smtp = send real email
EMAIL_PROVIDER=smtp
EMAIL_FROM=you@gmail.com

# Gmail SMTP (requires 2-Step Verification + a Google App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=you@gmail.com
SMTP_PASS=your_google_app_password
