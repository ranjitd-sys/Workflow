# Base URL of the backend chat API (leave empty to use the built-in mock stream)
PUBLIC_API_URL=

# Chat intent engine (server-side only — never expose these to the browser)
INTENT_LLM_API_KEY=
INTENT_LLM_BASE_URL=https://api.openai.com/v1
INTENT_LLM_MODEL=gpt-4.1-mini
# Use a local deterministic classifier instead of an LLM (for wiring/demo only)
INTENT_LLM_MOCK=false
